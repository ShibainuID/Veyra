{
  "openapi": "3.1.0",
  "info": {
    "title": "VEYRA API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/{media_id}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Get Media",
        "operationId": "get_media_api_v1_media__media_id__get",
        "parameters": [
          {
            "name": "media_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Media Id"
            }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Exp"
            }
          },
          {
            "name": "sig",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Sig"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo/reset": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Reset",
        "operationId": "reset_api_v1_demo_reset_post",
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "fresh",
                "post-enrollment"
              ],
              "type": "string",
              "default": "fresh",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo/settings": {
      "get": {
        "tags": [
          "demo"
        ],
        "summary": "Get Demo Settings",
        "operationId": "get_demo_settings_api_v1_demo_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoSettingsOut"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "demo"
        ],
        "summary": "Put Demo Settings",
        "operationId": "put_demo_settings_api_v1_demo_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoSettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoSettingsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DemoSettingsOut": {
        "properties": {
          "payment_mode": {
            "type": "string",
            "enum": [
              "succeed",
              "fail",
              "timeout"
            ],
            "title": "Payment Mode"
          },
          "insurer_activation": {
            "type": "string",
            "enum": [
              "confirm",
              "withhold"
            ],
            "title": "Insurer Activation"
          },
          "farm_id": {
            "type": "string",
            "title": "Farm Id"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "payment_mode",
          "insurer_activation",
          "farm_id",
          "updated_at"
        ],
        "title": "DemoSettingsOut"
      },
      "DemoSettingsUpdate": {
        "properties": {
          "payment_mode": {
            "type": "string",
            "enum": [
              "succeed",
              "fail",
              "timeout"
            ],
            "title": "Payment Mode"
          },
          "insurer_activation": {
            "type": "string",
            "enum": [
              "confirm",
              "withhold"
            ],
            "title": "Insurer Activation"
          }
        },
        "type": "object",
        "required": [
          "payment_mode",
          "insurer_activation"
        ],
        "title": "DemoSettingsUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ResetResult": {
        "properties": {
          "status": {
            "type": "string",
            "const": "reset",
            "title": "Status"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "fresh",
              "post-enrollment"
            ],
            "title": "Scenario"
          },
          "animals": {
            "type": "integer",
            "title": "Animals"
          }
        },
        "type": "object",
        "required": [
          "status",
          "scenario",
          "animals"
        ],
        "title": "ResetResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}