# VEYRA configuration. Every value is optional: the defaults below run the demo.
# The API reads the process environment (it does not load this file); export what you change
# in the shell that starts uvicorn. Never commit a real key.

# --- API (services/api) ---

# Where the SQLite database and uploaded media live (default: services/api/.data).
# VEYRA_DATA_DIR=services/api/.data

# Database URL. SQLite only; the session rules in persistence/db.py are SQLite-specific.
# VEYRA_DATABASE_URL=sqlite:///services/api/.data/veyra.db

# Signs media URLs. Without it a random per-process secret is used and links stop working after a restart.
# VEYRA_MEDIA_SECRET=change-me-to-a-long-random-string

# Token for the internal worker endpoints (X-Service-Token header).
# VEYRA_SERVICE_TOKEN=demo-worker-token

# Run background jobs inline instead of on the worker pool (true/false).
# VEYRA_SYNC_JOBS=false

# Camera replay speed multiplier; 0 ingests a whole replay at once.
# VEYRA_REPLAY_SPEED=10

# auto | prototype | fixture. auto uses each installed ML capability; fixture uses labeled fixtures only.
# VEYRA_PERCEPTION_MODE=auto

# auto | live | offline. auto uses Claude when ANTHROPIC_API_KEY is set.
# VEYRA_LLM_MODE=auto

# Claude model for policy explanations and question parsing.
# VEYRA_LLM_MODEL=claude-opus-5-5

# Expose /api/v1/demo/* (reset, replays, sandbox switches).
# VEYRA_DEMO_MODE=true

# Segmentation weights for the weight step: an Ultralytics name or a local path.
# VEYRA_YOLO_WEIGHTS=yolov8x-seg.pt

# Enables live Claude. Leave unset for the offline template explanation and parser.
# ANTHROPIC_API_KEY=

# --- Web (apps/web) ---

# Where the Vite dev and preview servers proxy /api.
# VEYRA_API_TARGET=http://127.0.0.1:8000
